# Переменные для docker-compose.prod.yml (пароли базы).
# Скопируйте в .env рядом с compose-файлом.
# DB_PASSWORD здесь и в backend/.env должны совпадать.

DB_DATABASE=food_guru
DB_USERNAME=food_guru
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Общий секрет SSR-сервера и API (то же значение — в backend/.env).
# Сгенерировать: openssl rand -hex 32
SSR_API_KEY=
