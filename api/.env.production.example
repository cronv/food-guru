# Боевое окружение Symfony API. Скопируйте в api/.env и заполните.
# APP_SECRET заполняется deploy.sh.

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=https://api.food-guru.ru
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://food_guru:CHANGE_ME@mysql:3306/food_guru?serverVersion=8.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

PUBLIC_STORAGE_URL=https://food-guru.ru/storage
STORAGE_PATH=/var/www/storage

SITE_URL=https://food-guru.ru
ADMIN_URL=https://admin.food-guru.ru

# Общий домен cookie: и сайт, и админка должны видеть XSRF-TOKEN.
SESSION_DOMAIN=.food-guru.ru
STATEFUL_DOMAINS=food-guru.ru,www.food-guru.ru,admin.food-guru.ru

SSR_API_KEY=

# Почта. Адрес SMTP-сервиса; спецсимволы в пароле — в процентной кодировке.
# Пример: smtp://no-reply%40food-guru.ru:ПАРОЛЬ@smtp.example-provider.com:587
# Без настоящего адреса письма подтверждения и входа не уйдут.
MAILER_DSN=
# Отправитель, который увидит получатель. Без него Symfony не отправит ни одно письмо.
MAIL_FROM_ADDRESS="Food Guru <no-reply@food-guru.ru>"

# test — только dev/test; в prod пустое значение отключает тестовую оплату.
PAYMENT_PROVIDER=