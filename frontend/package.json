{
  "name": "food-guru-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Публичный сайт с SSR и админ-панель",
  "scripts": {
    "start": "ng serve site",
    "start:admin": "ng serve admin",
    "build": "npm run build:site && npm run build:admin",
    "build:site": "ng build site --configuration production",
    "build:admin": "ng build admin --configuration production",
    "serve:ssr": "node dist/site/server/server.mjs",
    "watch": "ng build site --watch --configuration development",
    "test": "ng test site --watch=false --browsers=ChromeHeadless",
    "test:admin": "ng test admin --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test site",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/platform-server": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/ssr": "^21.2.29",
    "express": "^4.19.2",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.25",
    "@types/express": "^4.17.21",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^20.14.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.15.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=18.19"
  }
}