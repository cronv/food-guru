APP_NAME="Food Guru"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

# Адрес API. Попадает в ссылки внутри писем, если SITE_URL не задан.
APP_URL=http://localhost:8000

# Адрес публичного сайта: на него ведёт ссылка подтверждения из письма.
SITE_URL=http://localhost:4200

# Адрес админки.
ADMIN_URL=http://localhost:4300

# Общий секрет с SSR-сервером сайта: с ним лимит API считается по посетителю, а не один на всех.
SSR_API_KEY=dev-ssr-key

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=food_guru
DB_USERNAME=food_guru
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=43200
# Родительский домен, чтобы cookie работала и на сайте, и в админке.
SESSION_DOMAIN=localhost
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:4200,localhost:4300

# Письма уходят через очередь, чтобы не блокировать запрос регистрации.
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@food-guru.local"
MAIL_FROM_NAME="${APP_NAME}"

# Время жизни одноразовых ссылок.
VERIFY_TOKEN_TTL_HOURS=24
LOGIN_TOKEN_TTL_MINUTES=15
