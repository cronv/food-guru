# Боевое окружение. Скопируйте в backend/.env и заполните.
# APP_KEY получается командой: php artisan key:generate

APP_NAME="Food Guru"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

# Адреса. Поменяйте на свой домен — они попадают в ссылки внутри писем.
APP_URL=https://api.food-guru.ru
SITE_URL=https://food-guru.ru

# Платёжная система. «test» (тестовая оплата без денег) в production выключена
# в коде: пока здесь не указан настоящий провайдер, пополнение отвечает 503.
PAYMENT_PROVIDER=
ADMIN_URL=https://admin.food-guru.ru

# Общий секрет с SSR-сервером сайта. В Docker задаётся в .env рядом с compose и сюда
# не нужен. На обычном хостинге — то же значение, что у SSR-сервера в переменной SSR_API_KEY.
# Сгенерировать: openssl rand -hex 32. Без него под нагрузкой сайт начнёт отдавать ошибки.
SSR_API_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=food_guru
DB_USERNAME=food_guru
# Длинный случайный пароль. Он же нужен в .env рядом с docker-compose.prod.yml.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
# Точка в начале: cookie действует и на поддоменах (сайт + админка).
SESSION_DOMAIN=.food-guru.ru
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=food-guru.ru,www.food-guru.ru,admin.food-guru.ru

QUEUE_CONNECTION=database
CACHE_STORE=database

# Почта. Для писем подтверждения берите сервис с хорошей доставляемостью:
# на SMTP хостинга письма часто уходят в спам.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@food-guru.ru"
MAIL_FROM_NAME="${APP_NAME}"

VERIFY_TOKEN_TTL_HOURS=24
LOGIN_TOKEN_TTL_MINUTES=15
